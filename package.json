{
  "name": "husay",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && node scripts/deploy-pages.ts",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply husay-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply husay-db --remote",
    "db:seed:local": "wrangler d1 execute husay-db --local --file seed/sample-program.sql",
    "user:create": "node scripts/create-user.ts",
    "user:create:remote": "node scripts/create-user.ts --remote"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "drizzle-orm": "^0.45.4",
    "html2canvas-pro": "^2.5.2",
    "isbot": "^5.1.36",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.151.2"
  }
}
